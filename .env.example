# ── Supabase ──────────────────────────────────────────────────────────────────
# Public URL for your Supabase project
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key — server-side ONLY. Never expose in the browser or commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Monad ─────────────────────────────────────────────────────────────────────
# RPC endpoint for Monad mainnet
MONAD_RPC_URL=https://rpc.monad.xyz

# Private key of the signing wallet (0x-prefixed). Keep this secret.
MONAD_PRIVATE_KEY=0xyour-private-key-here

# Deployed address of TitanEventLogger.sol on Monad mainnet
TITAN_EVENT_LOGGER_ADDRESS=0xyour-contract-address-here

# ── Frontend (existing — do not change) ───────────────────────────────────────
# These are safe for the browser (anon key only — not service role)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
